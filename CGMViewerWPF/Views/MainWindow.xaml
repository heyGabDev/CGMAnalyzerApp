<Window x:Class="CGMViewerWPF.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="CGM Viewer App - Visualiseur de fichiers CGM" 
        Height="800" Width="1400" 
        MinHeight="600" MinWidth="1000"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Styles -->
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF0078D4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF106EBE"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#FF005A9E"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="HeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#FF2D2D30"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="StatusTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#FF6D6D6D"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="#FFF6F6F6" BorderBrush="#FFE0E0E0" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Margin="12,8">
                <Button Content="📁 Importer CGM" 
                        Command="{Binding ImportFilesCommand}"
                        Style="{StaticResource ModernButtonStyle}"
                        Margin="0,0,8,0"/>

                <Button Content="🗑️ Effacer tout" 
                        Command="{Binding ClearImportedFilesCommand}"
                        Background="#FFDC3545" 
                        Style="{StaticResource ModernButtonStyle}"
                        Margin="0,0,8,0"/>

                <Button Content="❌ Supprimer sélection" 
                        Command="{Binding RemoveSelectedFileCommand}"
                        Background="#FF6C757D" 
                        Style="{StaticResource ModernButtonStyle}"
                        Margin="0,0,16,0"/>

                <TextBlock Text="{Binding ImportedFiles.Count, StringFormat='Fichiers: {0}'}" 
                           Style="{StaticResource StatusTextStyle}"
                           Margin="8,0"/>
            </StackPanel>
        </Border>

        <!-- Progress & Status - CORRIGÉ -->
        <Border Grid.Row="1" Background="#FFFAFAFA" BorderBrush="#FFE0E0E0" BorderThickness="0,0,0,1">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsLoading}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel Margin="12,8">
                <TextBlock Text="{Binding StatusMessage}" 
                           Style="{StaticResource StatusTextStyle}"
                           Margin="0,0,0,4"/>
                <ProgressBar Value="{Binding ProcessingProgress}" 
                             Maximum="100" Height="4"
                             Background="#FFE0E0E0"
                             Foreground="#FF0078D4"/>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="2" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="250"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="2*" MinWidth="400"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="300" MinWidth="200"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel - File List -->
            <Border Grid.Column="0" Background="White" BorderBrush="#FFE0E0E0" BorderThickness="1" 
                    CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Border Grid.Row="0" Background="#FFF8F9FA" BorderBrush="#FFE0E0E0" BorderThickness="0,0,0,1"
                            CornerRadius="4,4,0,0">
                        <TextBlock Text="📋 Fichiers Importés" 
                                   Style="{StaticResource HeaderTextStyle}"
                                   Margin="12,8"/>
                    </Border>

                    <!-- File List -->
                    <ListBox Grid.Row="1" 
                             ItemsSource="{Binding ImportedFiles}"
                             SelectedItem="{Binding SelectedFile}"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="8,4">
                                    <TextBlock Text="{Binding FileName}" 
                                               FontWeight="Medium"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Layers.Count, StringFormat='Layers: {0}'}" 
                                               FontSize="10"
                                               Foreground="#FF6D6D6D"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Summary -->
                    <Border Grid.Row="2" Background="#FFF8F9FA" BorderBrush="#FFE0E0E0" BorderThickness="0,1,0,0">
                        <TextBlock Text="{Binding ImportedFiles.Count, StringFormat='Total: {0} fichier(s)'}" 
                                   Style="{StaticResource StatusTextStyle}"
                                   Margin="12,6"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="5" Background="#FFE0E0E0" 
                          ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"/>

            <!-- Center Panel - Image Preview -->
            <Border Grid.Column="2" Background="White" BorderBrush="#FFE0E0E0" BorderThickness="1" 
                    CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Border Grid.Row="0" Background="#FFF8F9FA" BorderBrush="#FFE0E0E0" BorderThickness="0,0,0,1"
                            CornerRadius="4,4,0,0">
                        <TextBlock Text="🖼️ Aperçu de l'image" 
                                   Style="{StaticResource HeaderTextStyle}"
                                   Margin="12,8"/>
                    </Border>

                    <!-- Image Display - CORRIGÉ -->
                    <ScrollViewer Grid.Row="1" 
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto"
                                  Background="#FFF5F5F5">
                        <Grid>
                            <!-- Image -->
                            <Image Source="{Binding ImageSource}" 
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality">
                                <Image.Style>
                                    <Style TargetType="Image">
                                        <Style.Triggers>
                                            <Trigger Property="Source" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Image.Style>
                            </Image>

                            <!-- Placeholder -->
                            <TextBlock Text="🖼️ Sélectionnez un fichier pour voir l'aperçu"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="16"
                                       Foreground="#FF6D6D6D">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ImageSource}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Column="3" Width="5" Background="#FFE0E0E0" 
                          ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"/>

            <!-- Right Panel - Properties & Layers -->
            <Border Grid.Column="4" Background="White" BorderBrush="#FFE0E0E0" BorderThickness="1" 
                    CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Layers Header -->
                    <Border Grid.Row="0" Background="#FFF8F9FA" BorderBrush="#FFE0E0E0" BorderThickness="0,0,0,1"
                            CornerRadius="4,4,0,0">
                        <TextBlock Text="🎭 Couches (Layers)" 
                                   Style="{StaticResource HeaderTextStyle}"
                                   Margin="12,8"/>
                    </Border>

                    <!-- Layers List -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding SelectedFileLayers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Name}" 
                                              IsChecked="{Binding IsChecked}"
                                              Margin="12,4,12,4"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Errors Header -->
                    <Border Grid.Row="2" Background="#FFFFF3E0" BorderBrush="#FFE0E0E0" BorderThickness="0,1,0,1">
                        <TextBlock Text="⚠️ Messages et Erreurs" 
                                   Style="{StaticResource HeaderTextStyle}"
                                   Margin="12,8"/>
                    </Border>

                    <!-- Errors List -->
                    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Errors}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" 
                                               TextWrapping="Wrap"
                                               Margin="12,4"
                                               FontSize="11"
                                               Foreground="#FFDC3545"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="3" Background="#FFF6F6F6" BorderBrush="#FFE0E0E0" BorderThickness="0,1,0,0">
            <Grid Margin="12,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" 
                           Text="{Binding StatusMessage}" 
                           Style="{StaticResource StatusTextStyle}"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="CGM Viewer v2.0 • " 
                               Style="{StaticResource StatusTextStyle}"/>
                    <TextBlock Text="{Binding Source={x:Static sys:DateTime.Now}, StringFormat='HH:mm:ss'}" 
                               Style="{StaticResource StatusTextStyle}"
                               x:Name="ClockTextBlock"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Loading Overlay - CORRIGÉ -->
        <Border Grid.RowSpan="4" 
                Background="#80000000">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsLoading}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" 
                             Width="200" Height="4"
                             Background="#FFE0E0E0"
                             Foreground="#FF0078D4"/>
                <TextBlock Text="{Binding StatusMessage}" 
                           Foreground="White"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,0"
                           FontWeight="Medium"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>